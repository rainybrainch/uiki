generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  // ローカル: sqlite / 本番: postgresql (Neon)
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── プロジェクト ──────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#3a6fc9")
  icon        String?  // emoji or icon name
  archived    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
}

// ─── タスク ───────────────────────────────────────────────

model Task {
  id          String    @id @default(cuid())
  title       String
  memo        String?
  priority    Priority  @default(MEDIUM)
  dueDate     DateTime?
  column      String    @default("todo")
  order       Int       @default(0)
  completed   Boolean   @default(false)
  tags        String?   // CSV: "仕事,個人"
  recurrence  String?   // "daily" | "weekly" | "monthly" | null
  recNextDate String?   // 次回生成日 YYYY-MM-DD
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  subtasks    SubTask[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SubTask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  completed Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// ─── 習慣 ───────────────────────────────────────────────

model Habit {
  id          String      @id @default(cuid())
  name        String
  description String?
  color       String      @default("#3a6fc9")
  createdAt   DateTime    @default(now())
  logs        HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

// ─── 日記 ───────────────────────────────────────────────

model DiaryEntry {
  id        String   @id @default(cuid())
  date      String
  title     String
  content   String
  mood      Int?     // 1-5（気分スコア）
  tags      String?  // CSV
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
}

// ─── ライブラリ ───────────────────────────────────────────

model LibraryItem {
  id         String     @id @default(cuid())
  type       ItemType   @default(BOOK)
  title      String
  creator    String?
  url        String?
  coverUrl   String?
  status     ItemStatus @default(WANT)
  rating     Int?
  note       String?
  tags       String?    // CSV
  finishedAt String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// ─── 設定 ───────────────────────────────────────────────

model Settings {
  id        String   @id @default("singleton")
  city      String?
  lat       Float?
  lon       Float?
  // ぽもじかん連携フック（将来用）
  pomojikanUrl    String?
  pomojikanActive Boolean  @default(false)
  apiKey          String?  // 外部連携用APIキー
  updatedAt DateTime @updatedAt
}

// ─── 週次レポートキャッシュ ───────────────────────────────

model WeeklySnapshot {
  id             String   @id @default(cuid())
  weekStart      String   // YYYY-MM-DD（月曜日）
  tasksCompleted Int      @default(0)
  habitsRate     Float    @default(0) // 0.0〜1.0
  diaryCount     Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([weekStart])
}

// ─── 重力雨域 ─────────────────────────────────────────────

model GravityLog {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD
  text      String   // 最大280字
  intensity Int      @default(1) // 1=微熱 / 2=燃焼 / 3=臨界
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── 引力雨域 ─────────────────────────────────────────────

model AttractionMetric {
  id        String   @id @default(cuid())
  name      String   // 項目名（例: 貯金・体重・読書量）
  value     Float    @default(0) // 最新値（キャッシュ）
  target    Float?   // 目標値（任意）
  unit      String?  // 単位（円・kg・冊など）
  color     String   @default("#3a6fc9")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs      AttractionLog[]
}

model AttractionLog {
  id         String           @id @default(cuid())
  metricId   String
  date       String           // YYYY-MM-DD
  value      Float
  createdAt  DateTime         @default(now())
  metric     AttractionMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([metricId, date])
}

// ─── 案件パイプライン ──────────────────────────────────────

model Case {
  id          String     @id @default(cuid())
  name        String
  client      String?
  reward      Int        @default(0)   // 円
  paidAmount  Int        @default(0)   // 実際に受け取った額
  status      CaseStatus @default(ACQUIRED)
  dueDate     DateTime?
  memo        String?
  category    String?    // AI開発/Web制作/ゲーム/その他
  relatedTasks String?   // タスクIDのCSV（簡易紐づけ）
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ─── 百層世界 ───────────────────────────────────────────

model Dream {
  id           String      @id @default(cuid())
  // ① 世界名
  title        String
  // ② 定義
  definition   String?
  // ③ 目的/ビジョン
  vision       String?
  // ④ 誓約
  vow          String?
  // ⑤ 制約
  constraints  String?
  // ⑥ 期間
  period       String?     // テキスト（例: "2026年中"）
  // ⑦ 評価軸/KPI
  kpi          String?
  // ⑧ 相互関連性
  connections  String?     // 他の世界名のCSV

  category    DreamCat    @default(OTHER)
  layer       Int         @default(1)   // 1〜100層
  progress    Int         @default(0)   // 0〜100%
  achieved    Boolean     @default(false)
  achievedAt  DateTime?
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ─── 修正ログ（月次Act記録）────────────────────────────────

model AdjustmentLog {
  id        String     @id @default(cuid())
  month     String     // YYYY-MM
  type      AdjType    @default(MONTHLY)
  // 何を変えたか
  what      String
  // なぜ変えたか
  why       String?
  // 結果はどうだったか
  result    String?
  // 誓約は守れていたか（週次Check用）
  vowCheck  Boolean?
  // 制約の中で実行できていたか
  constCheck Boolean?
  // 目的に向かって進んでいたか
  visionCheck Boolean?
  // 関連する世界（DreamのID or タイトル）
  relatedDream String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// ─── Enum ────────────────────────────────────────────────

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum ItemType {
  BOOK
  MOVIE
  MUSIC
  GAME
  YOUTUBE
  ARTICLE
  URL
  OTHER
}

enum ItemStatus {
  WANT
  DOING
  DONE
}

enum CaseStatus {
  ACQUIRED     // 獲得
  DEVELOPING   // 開発中
  DELIVERED    // 納品済み
  WAITING_PAY  // 支払い待ち
  DONE         // 完了
}

enum DreamCat {
  OATH         // 十二の誓い
  PROJECT      // プロジェクト
  HABIT        // 習慣・継続
  BODY         // 身体
  BUSINESS     // 事業
  CREATIVE     // 創作
  OTHER        // その他
}

enum AdjType {
  WEEKLY   // 週次Check
  MONTHLY  // 月次Act
}
