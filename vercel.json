{
  "installCommand": "npm install",
  "buildCommand": "cd packages/database && npx prisma generate && cd ../../apps/uwiki && npx next build",
  "outputDirectory": "apps/uwiki/.next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/persona-generate",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 15 * * *"
    }
  ]
}
